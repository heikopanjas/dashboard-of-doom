# Build artifacts
Build/

# Xcode derived data components (land at workspace root with custom build location)
Logs/
Index.noindex/
CompilationCache.noindex/
ModuleCache.noindex/
SDKStatCaches.noindex/
SourcePackages/
info.plist

# Xcode user data
xcuserdata/
*.xcuserstate
*.xcuserdatad

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# fastlane
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# Crashlytics
crashlytics-build.properties

# XcodeGen output; retain the Swift package lockfile for reproducible builds
/DashboardOfDoom.xcodeproj/**
!/DashboardOfDoom.xcodeproj/project.xcworkspace/
!/DashboardOfDoom.xcodeproj/project.xcworkspace/xcshareddata/
!/DashboardOfDoom.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
!/DashboardOfDoom.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Build script test bytecode
__pycache__/

# Legacy distribution script outputs on case-sensitive filesystems
/build/
